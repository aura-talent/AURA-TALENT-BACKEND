# --- LLM provider keys (server-side, never exposed to the frontend) ---
# Set the key matching your MODEL_NAME provider:
ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=AIza...          # for MODEL_NAME=google_genai:gemini-3.5-flash (AI Studio key)
# OPENAI_API_KEY=sk-...           # for MODEL_NAME=openai:gpt-...

# --- Vertex AI (uses GCP credits; no API key — auth via gcloud ADC) ---
# 1. gcloud auth application-default login
# 2. Enable the Vertex AI API on your project
# 3. Set MODEL_NAME=google_vertexai:gemini-3.5-flash and the two vars below
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Model used by all graphs. Format: "<provider>:<model-id>" (langchain init_chat_model).
# Examples: anthropic:claude-sonnet-4-6 | google_vertexai:gemini-3.5-flash | google_genai:gemini-3.5-flash
MODEL_NAME=anthropic:claude-sonnet-4-6

# --- Backend auth ---
# Shared secret your frontend sends as the X-API-Key header.
# Replace with real per-user auth (JWT/session) before charging users.
BACKEND_API_KEY=change-me

# --- Paths ---
# Root of the career-ops repo (for portals.yml / modes). Defaults to parent dir.
# CAREER_OPS_ROOT=/path/to/career-ops
# SQLite database location
# DATABASE_PATH=./career_ops.db

# Comma-separated origins allowed by CORS (your frontend URLs)
CORS_ORIGINS=http://localhost:3000

MODEL_NAME=google_vertexai:gemini-2.5-flash
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# --- Salary intelligence (optional) ---
# Adzuna free salary API — https://developer.adzuna.com/ (register an app).
# Without these, salary estimates fall back to LLM-only with low confidence.
# ADZUNA_APP_ID=your-app-id
# ADZUNA_APP_KEY=your-app-key
# Country for histogram queries: gb us au ca de fr nl in sg nz ... (no MY).
# ADZUNA_COUNTRY=us